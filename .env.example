# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"

# -----------------------------------------------------------------------
# Scoring agents
#
# Both agents default to Claude Haiku 4.5 — the cheapest Claude tier.
#
# Running the critic on a different vendor is the stronger setup (an auditor
# that shares the evaluator's model shares its blind spots), and this is
# configurable per agent. It defaults to Anthropic because the Gemini free tier
# answered `503 UNAVAILABLE` for hours at a time; with a billed Google key,
# set LLM_CRITIC_PROVIDER="google" to get the cross-vendor audit back.
# -----------------------------------------------------------------------

# Which vendor serves each agent: "anthropic" or "google".
LLM_EVALUATOR_PROVIDER="anthropic"
LLM_CRITIC_PROVIDER="anthropic"

# Anthropic (evaluator by default). Key from https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL_ID="claude-haiku-4-5"
# Optional. Model for the critic when LLM_CRITIC_PROVIDER=anthropic.
# ANTHROPIC_CRITIC_MODEL_ID="claude-sonnet-5"
# Optional. Output cap per reply; raise it if replies are cut off (default 8000).
# ANTHROPIC_MAX_TOKENS="8000"

# Google Gemini (only used when an agent is set to the "google" provider)
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_ID="gemini-flash-lite-latest"
# Optional. Model for the critic when LLM_CRITIC_PROVIDER=google.
# Defaults to GEMINI_MODEL_ID.
# GEMINI_CRITIC_MODEL_ID="gemini-flash-lite-latest"

# Optional. Base URL of this deployment, used by background jobs that need to
# know their own origin. Left unset, Vercel's own env vars are used when
# present, otherwise http://localhost:3000.
# APP_BASE_URL="https://your-app.vercel.app"
