# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"

# Google Gemini (free tier, no credit card required)
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_ID="gemini-flash-lite-latest"

# Optional. Base URL of this deployment, used by background jobs that need to
# know their own origin. Left unset, Vercel's own env vars are used when
# present, otherwise http://localhost:3000.
# APP_BASE_URL="https://your-app.vercel.app"
