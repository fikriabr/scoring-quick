# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"

# Google Gemini (free tier, no credit card required)
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_ID="gemini-flash-lite-latest"

# Manual capture pipeline (see docs/CAPTURE.md)
# Shared secret between the app and scripts/partyrock-navigate.js. Any long
# random string; POST /api/capture rejects everything else.
CAPTURE_TOKEN="generate-with-openssl-rand-hex-24"
# Optional. Left unset, the capture script uses the Vercel domain when
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are present, otherwise
# http://localhost:3000. Set it only to force a specific target, or pass
# --base-url per run.
# APP_BASE_URL="https://your-app.vercel.app"
# Optional: use your real Chrome profile for capture instead of the empty
# .pr-chrome-profile folder. Prefer `npm run capture:clone-profile` — Google
# blocks sign-in in automated browsers, so cloning an already-signed-in profile
# works where logging in fresh does not. See docs/CAPTURE.md.
#
# If you do point at the real profile: PR_CHROME_PROFILE is the "User Data"
# folder, PR_CHROME_PROFILE_DIR picks the profile inside it, and Chrome must be
# fully closed while capture runs.
# PR_CHROME_PROFILE="C:/Users/you/AppData/Local/Google/Chrome/User Data"
# PR_CHROME_PROFILE_DIR="Default"
# Where clone-chrome-profile.js reads from, if Chrome is installed unusually.
# PR_CHROME_SOURCE_PROFILE="C:/Users/you/AppData/Local/Google/Chrome/User Data"
